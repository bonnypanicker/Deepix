# R8 rules for the release build.
#
# Most of the stack ships its own consumer rules inside its artifact and needs nothing here: Room,
# WorkManager, Glide (modules and enums), Media3, Billing, the AVIF decoder and heifwriter. What
# follows is what the app itself owns — reflection those rules do not cover.

# --- ONNX Runtime -----------------------------------------------------------------------
# libonnxruntime4j_jni.so exports its entry points under the Java names it binds
# (Java_ai_onnxruntime_OnnxTensor_createTensor, ...Java_ai_onnxruntime_OnnxRuntime_...), and this
# AAR ships no consumer rules. Renaming or removing any of those classes fails the first inference
# with an UnsatisfiedLinkError at runtime — never at build time. Face detection, face embeddings and
# the image encoder all run through this package, so a broken keep here looks like "search silently
# finds nothing" on a device while every test here still passes.
-keep class ai.onnxruntime.** { *; }

# --- Glide ------------------------------------------------------------------------------
# Glide finds the module the kapt Glide compiler generated by name:
#   Class.forName("com.bumptech.glide.GeneratedAppGlideModuleImpl")
# Glide's own rules keep the @GlideModule classes themselves, but not that generated entry point.
-keep public class com.bumptech.glide.GeneratedAppGlideModuleImpl {
    public <init>(android.content.Context);
}

# --- Diagnostics ------------------------------------------------------------------------
# Play's crash reports are deobfuscated from the mapping file, but only member names are restored;
# without the line table every frame collapses onto line 1 of the class. SourceFile is renamed so
# the project layout (com/devomind/gallerysearch/...) is not disclosed by a stack trace.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# Generics and runtime annotations are read reflectively by Room and Kotlin, and annotations survive
# for libraries that inspect them at runtime.
-keepattributes Signature,RuntimeVisibleAnnotations,RuntimeInvisibleAnnotations,AnnotationDefault,InnerClasses,EnclosingMethod
