<?xml version="1.0" encoding="utf-8"?>
<!-- Dark stroked pill (viewer/indexing action chips). Pressed: Metro white-alpha overlay. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="#D90A0A0A" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/metroBgSurface" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="@color/metroPressOverlay" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#D90A0A0A" />
            <stroke
                android:width="1dp"
                android:color="@color/metroBgSurface" />
        </shape>
    </item>
</selector>
