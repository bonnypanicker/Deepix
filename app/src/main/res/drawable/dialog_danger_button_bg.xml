<?xml version="1.0" encoding="utf-8"?>
<!-- Destructive primary action pill. Fixed Metro red — deliberately NOT the user accent, so
     delete/purge confirms read as dangerous under every accent choice. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/metroDanger" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</ripple>
