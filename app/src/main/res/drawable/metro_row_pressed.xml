<?xml version="1.0" encoding="utf-8"?>
<!-- The app's single tactile language: flat square white-alpha overlay for pressed state and a
     subtler one for keyboard/D-pad focus. Applied to every interactive Metro surface (rows,
     icon buttons, chips, dialog actions, command bars) instead of platform ripples. Colored
     buttons (accent pills, danger bar, accent tiles) reproduce the same overlay on top of their
     own fill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/metroPressOverlay" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/metroFocusOverlay" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
