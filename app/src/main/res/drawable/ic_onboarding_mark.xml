        android:pathData="M28,32h122v92H28z"
        android:fillColor="#5CC8F2" />

    <!-- Sun circle in left photo -->
    <circle
        android:fillColor="#FFD45C"
        android:centerX="130.5"
        android:centerY="50.4"
        android:radius="8.8" />

