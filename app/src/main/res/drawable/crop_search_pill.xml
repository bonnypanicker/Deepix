<?xml version="1.0" encoding="utf-8"?>
<!-- Accent action pill. Pressed state folds the same white-alpha overlay used by
     metro_row_pressed so colored buttons speak the same tactile language as rows. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="?attr/accentColor" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="@color/metroPressOverlay" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="?attr/accentColor" />
        </shape>
    </item>
</selector>
