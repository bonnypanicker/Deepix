<?xml version="1.0" encoding="utf-8"?>
<!-- "Today" marker in MetroDatePicker: a thin accent ring around the number, not a filled pill,
     so today stays legible beside the accent-coloured day the user is about to tap. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="?attr/accentColor" />
</shape>
