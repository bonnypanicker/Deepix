<?xml version="1.0" encoding="utf-8"?>
<!-- Metro/WP10 selection tick: accent rounded-square chip with a hairline black
     border so the checkmark stays legible over bright thumbnails. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/metroAccent" />
    <corners android:radius="3dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/metroBgPrimary" />
</shape>
