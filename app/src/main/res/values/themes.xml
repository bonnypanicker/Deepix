<resources>
    <style name="Theme.GallerySearch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/metroNavBar</item>
        <item name="android:statusBarColor">@color/metroStatusBar</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="colorAccent">@color/metroAccent</item>
        <!-- Popup windows (overflow menus, list popups) share the Metro dialog panel look. -->
        <item name="popupMenuStyle">@style/MetroPopupMenu</item>
        <item name="listPopupWindowStyle">@style/MetroListPopupWindow</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Metro.PopupItem</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.Metro.PopupItem</item>
        <!-- Default accent values (Azure). Overridden at runtime by AccentPalette overlays. -->
        <item name="accentColor">@color/metroAccent</item>
        <item name="accentColorLight">@color/metroAccentLight</item>
        <item name="accentColorAlpha14">#243B9EFF</item>
        <item name="accentColorAlpha80">#CC3B9EFF</item>
    </style>

    <!-- ===================== Accent color overlays =====================
         Applied at runtime via AccentPalette.apply(activity). Each sets the accentColor
         family + colorAccent so SwitchCompat / CheckBox / SeekBar tints follow too. -->
    <!-- Empty base: dotted children (Accent.Azure etc.) implicitly inherit from it. -->
    <style name="Accent" />

    <style name="Accent.Azure">
        <item name="accentColor">#FF3B9EFF</item>
        <item name="accentColorLight">#FF6DB8FF</item>
        <item name="accentColorAlpha14">#243B9EFF</item>
        <item name="accentColorAlpha80">#CC3B9EFF</item>
        <item name="colorAccent">#FF3B9EFF</item>
    </style>

    <style name="Accent.Violet">
        <item name="accentColor">#FF8B5CF6</item>
        <item name="accentColorLight">#FFA78BFA</item>
        <item name="accentColorAlpha14">#248B5CF6</item>
        <item name="accentColorAlpha80">#CC8B5CF6</item>
        <item name="colorAccent">#FF8B5CF6</item>
    </style>

    <style name="Accent.Teal">
        <item name="accentColor">#FF14B8A6</item>
        <item name="accentColorLight">#FF2DD4BF</item>
        <item name="accentColorAlpha14">#2414B8A6</item>
        <item name="accentColorAlpha80">#CC14B8A6</item>
        <item name="colorAccent">#FF14B8A6</item>
    </style>

    <style name="Accent.Emerald">
        <item name="accentColor">#FF22C55E</item>
        <item name="accentColorLight">#FF4ADE80</item>
        <item name="accentColorAlpha14">#2422C55E</item>
        <item name="accentColorAlpha80">#CC22C55E</item>
        <item name="colorAccent">#FF22C55E</item>
    </style>

    <style name="Accent.Amber">
        <item name="accentColor">#FFF59E0B</item>
        <item name="accentColorLight">#FFFBBF24</item>
        <item name="accentColorAlpha14">#24F59E0B</item>
        <item name="accentColorAlpha80">#CCF59E0B</item>
        <item name="colorAccent">#FFF59E0B</item>
    </style>

    <style name="Accent.Rose">
        <item name="accentColor">#FFF43F5E</item>
        <item name="accentColorLight">#FFFB7185</item>
        <item name="accentColorAlpha14">#24F43F5E</item>
        <item name="accentColorAlpha80">#CCF43F5E</item>
        <item name="colorAccent">#FFF43F5E</item>
    </style>

    <!-- Launch splash (AndroidX core-splashscreen; backported to minSdk) -->
    <style name="Theme.GallerySearch.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.GallerySearch</item>
    </style>

    <style name="Theme.GallerySearch.Viewer" parent="Theme.GallerySearch">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">@color/metroNavBar</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <!-- ===================== Typography ramp =====================
         The named Metro text roles. New text should reference one of these via
         android:textAppearance instead of raw textSize/fontFamily attributes. -->
    <style name="TextAppearance.Metro" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/metroTextPrimary</item>
    </style>

    <!-- Large screen headline (Settings, Safe, Cleanup landing titles). -->
    <style name="TextAppearance.Metro.ScreenTitleLarge">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Main top-bar title ("collections", album names). -->
    <style name="TextAppearance.Metro.ScreenTitle">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Month/date group headers in the browse timeline. -->
    <style name="TextAppearance.Metro.TimelineHeader">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Small all-caps section labels (PINNED ALBUMS, timeline subtitles). -->
    <style name="TextAppearance.Metro.SectionLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/metroTextSecondary</item>
    </style>

    <!-- Dialog headline (thin uppercase, per dialog_smart_album.xml). -->
    <style name="TextAppearance.Metro.DialogTitle">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Tiny accent field label above an input (NAME, PASSWORD). -->
    <style name="TextAppearance.Metro.FieldLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/accentColor</item>
    </style>

    <style name="TextAppearance.Metro.Body">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Metro.BodySecondary">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/metroTextSecondary</item>
    </style>

    <style name="TextAppearance.Metro.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/metroTextTertiary</item>
    </style>

    <!-- Labels paired with bottom action icons. Medium weight keeps 12sp text crisp on AMOLED. -->
    <style name="TextAppearance.Metro.IconAction">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/metroTextPrimary</item>
    </style>

    <!-- Slightly smaller label used by the 4-across multi-select command bar. -->
    <style name="TextAppearance.Metro.SelectionAction">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">@color/metroTextSecondary</item>
    </style>

    <!-- Compact interactive labels such as the inline gallery sort control. -->
    <style name="TextAppearance.Metro.CompactAction">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/accentColor</item>
    </style>

    <!-- Flat footer button label (CANCEL / CREATE / DELETE). -->
    <style name="TextAppearance.Metro.ButtonLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="MetroDrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textColor">@color/metroTextPrimary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:background">@drawable/drawer_item_bg</item>
    </style>

    <style name="SettingsSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">26dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">?attr/accentColor</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/metro_row_pressed</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="SettingsRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/metroTextPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SettingsRowSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:textColor">@color/metroTextSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/metroDivider</item>
    </style>

    <style name="Theme.GallerySearch.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <!-- Inherit the active accent overlay from the host activity instead of forcing Azure. -->
        <item name="android:textColorPrimary">@color/metroTextPrimary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ===================== Popup windows =====================
     Overflow menus and list popups use the same panel as dialogs (dialog_metro_bg) instead of
     the stock AppCompat popup chrome, so every floating surface shares one language. -->
    <style name="MetroPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/dialog_metro_bg</item>
    </style>

    <style name="MetroListPopupWindow" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">@drawable/dialog_metro_bg</item>
    </style>

    <style name="TextAppearance.Metro.PopupItem" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/metroTextPrimary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- ===================== Photo editor ===================== -->
    <style name="EditorToolTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/metro_row_pressed</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="EditorToolIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:tint">@color/metroTextSecondary</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="EditorToolLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:textColor">@color/metroTextSecondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="EditorChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/search_filter_chip_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/metroTextPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="EditorSliderLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/metroTextSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="EditorSeek">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:progressTint">?attr/colorAccent</item>
        <item name="android:thumbTint">?attr/colorAccent</item>
    </style>

    <!-- Settings list slider: accent track + thumb on the AMOLED surface. -->
    <style name="SettingsSlider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:progressTint">?attr/colorAccent</item>
        <item name="android:progressBackgroundTint">@color/metroBgCard</item>
        <item name="android:thumbTint">?attr/colorAccent</item>
        <item name="android:splitTrack">false</item>
    </style>
</resources>
