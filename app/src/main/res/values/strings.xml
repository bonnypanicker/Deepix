    <!-- Metro-style onboarding strings from reference mock -->
    <string name="onboarding_welcome_eyebrow">YOUR PHOTOS. YOUR DEVICE.</string>
    <string name="onboarding_welcome_title">Your memories stay yours</string>
    <string name="onboarding_welcome_body">A smarter home for every photo and video. Search, organize, and rediscover your memories with AI that runs right on your device.</string>

    <string name="onboarding_search_eyebrow">Search</string>
    <string name="onboarding_search_title">Find it with a few words</string>
    <string name="onboarding_search_body">Try "golden hour at the beach" or tap a photo to find similar moments. Your whole library is searchable in one place.</string>

    <string name="onboarding_people_eyebrow">People</string>
    <string name="onboarding_people_title">Every face, in its place</string>
    <string name="onboarding_people_body">Pixa groups photos by the people in them as your library indexes—no tedious tagging or sorting required.</string>

    <string name="onboarding_smart_albums_eyebrow">Smart albums</string>
    <string name="onboarding_smart_albums_title">Albums that build themselves</string>
    <string name="onboarding_smart_albums_body">Create an album like "weekend hikes" or "my dog." Pixa finds matching photos and keeps the collection up to date.</string>

    <string name="onboarding_smart_cleanup_eyebrow">Smart cleanup</string>
    <string name="onboarding_smart_cleanup_title">Make room for what matters</string>
    <string name="onboarding_smart_cleanup_body">Spot duplicates, blurry shots, and screenshots, or compress photos to save space. You review every suggestion before anything is deleted or replaced.</string>

    <string name="onboarding_editor_eyebrow">Edit</string>
    <string name="onboarding_editor_title">Little fixes. Right here.</string>
    <string name="onboarding_editor_body">Crop, tune, annotate, or trim a clip without leaving your gallery or opening another app.</string>

    <string name="onboarding_safe_eyebrow">Safe</string>
    <string name="onboarding_safe_title">Your private photos, locked away</string>
    <string name="onboarding_safe_body">Move sensitive files to Safe, protected in an AES-256 encrypted ZIP with your password. Your files remain yours—even if you uninstall Pixa.</string>

    <!-- The Pro page states the free tier honestly rather than as a trial: what stays free is said
         first, because that is the promise the rest of the tour rests on. Limits are the ones in
