<?xml version="1.0" encoding="utf-8"?>
<!--
  Compatibility alias for legacy Inter references. The app uses its bundled Open Sans face for every
  weight so the visual typeface stays fixed regardless of any saved legacy font preference.
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        app:font="@font/open_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="300" />
    <font
        app:font="@font/open_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        app:font="@font/open_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        app:font="@font/open_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
