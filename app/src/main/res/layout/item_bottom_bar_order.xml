<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@drawable/metro_row_pressed"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/orderIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:tint="?attr/accentColor" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/orderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.Metro.Body" />

        <TextView
            android:id="@+id/orderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.Metro.Caption"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/orderUp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Move up"
        android:padding="10dp"
        android:src="@drawable/ic_fluent_arrow_up_24_regular"
        android:tint="@color/metroTextPrimary" />

    <ImageButton
        android:id="@+id/orderDown"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Move down"
        android:padding="10dp"
        android:src="@drawable/ic_fluent_arrow_down_24_regular"
        android:tint="@color/metroTextPrimary" />
</LinearLayout>
