<?xml version="1.0" encoding="utf-8"?>
<!-- Adding photos to a folder album is a browse-and-pick job, so the grid is the dialog: the tiles are
     the app's own (ImageAdapter), a tap selects rather than opens, and the two footers say what happens
     to the original. Same shell and button language as dialog_tag_album.xml, including the ScrollView
     root — sideways a phone is too short for the grid and the intro at once. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@drawable/dialog_metro_bg"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_fluent_folder_24_regular"
                android:tint="?attr/accentColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:includeFontPadding="false"
                android:text="@string/album_kind_folder"
                android:textAppearance="@style/TextAppearance.Metro.DialogTitle" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/albumPickGrid"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/albumPickStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:includeFontPadding="false"
            android:text="@string/album_pick_none"
            android:textAppearance="@style/TextAppearance.Metro.FieldLabel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/albumPickCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/metro_row_pressed"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/cancel"
                android:textAppearance="@style/TextAppearance.Metro.ButtonLabel"
                android:textColor="@color/metroTextSecondary" />

            <TextView
                android:id="@+id/albumPickCopy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/crop_search_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/album_copy_here"
                android:textAppearance="@style/TextAppearance.Metro.ButtonLabel"
                android:textColor="@color/metroTextPrimary" />

            <TextView
                android:id="@+id/albumPickMove"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/search_filter_chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/album_move_here"
                android:textAppearance="@style/TextAppearance.Metro.ButtonLabel"
                android:textColor="?attr/accentColor" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
