<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:layout_marginBottom="10dp"
    android:background="?attr/accentColor"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/metro_row_pressed"
    android:padding="16dp">

    <TextView
        android:id="@+id/tileCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:text="0"
        android:textColor="@color/metroTextPrimary"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/tileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:includeFontPadding="false"
        android:textColor="@color/metroTextPrimary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tileSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:alpha="0.85"
        android:includeFontPadding="false"
        android:textColor="@color/metroTextPrimary"
        android:textSize="12sp" />

    <!-- Shown only for a cleanup category Pixa Pro unlocks. Placed opposite the count so the tile's own
         numbers keep their positions, and drawn in the tile's text color: it is a quiet mark on a paid
         surface, not a badge over the finding. -->
    <ImageView
        android:id="@+id/tileLock"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:alpha="0.9"
        android:contentDescription="@string/locked"
        android:src="@drawable/ic_fluent_lock_closed_24_regular"
        android:tint="@color/metroTextPrimary"
        android:visibility="gone" />
</FrameLayout>
