<?xml version="1.0" encoding="utf-8"?>
<!-- Indexing status banner: label ("Indexing photos… 4,213 / 12,000" or paused/queued variant)
     with a static explainer subtitle, over a slim accent progress bar, plus a per-session
     dismiss X on the trailing edge. Tapping the banner opens IndexingActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="14dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/search_index_banner_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/metro_row_pressed"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bannerLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textColor="@color/metroTextPrimary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/bannerClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/metro_row_pressed"
            android:contentDescription="@string/search_dismiss_index_banner"
            android:padding="7dp"
            android:src="@drawable/ic_fluent_dismiss_24_regular"
            android:tint="@color/metroTextSecondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/bannerSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:includeFontPadding="false"
        android:text="@string/search_index_banner_subtitle"
        android:textColor="@color/metroTextSecondary"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/bannerProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:max="100"
        android:progressBackgroundTint="#2B2B2B"
        android:progressTint="?attr/accentColor" />
</LinearLayout>
