<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metroBgPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/closeBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/metro_row_pressed"
                android:contentDescription="@string/close"
                android:padding="10dp"
                android:src="@drawable/ic_fluent_dismiss_24_regular"
                android:tint="@color/metroTextPrimary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/edit"
                android:textColor="@color/metroTextPrimary"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/undoBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/metro_row_pressed"
                android:contentDescription="@string/undo"
                android:padding="10dp"
                android:src="@drawable/ic_fluent_arrow_undo_24_regular"
                android:tint="@color/metroTextPrimary" />

            <TextView
                android:id="@+id/saveBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/crop_search_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="20dp"
                android:paddingTop="9dp"
                android:paddingEnd="20dp"
                android:paddingBottom="9dp"
                android:text="@string/save"
                android:textColor="@color/metroTextPrimary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Image + overlays -->
        <FrameLayout
            android:id="@+id/editArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/editImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <com.devomind.gallerysearch.EditorCropView
                android:id="@+id/cropView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.devomind.gallerysearch.EditorQuadView
                android:id="@+id/quadView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.devomind.gallerysearch.EditorDrawView
                android:id="@+id/drawView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Per-tool control panel -->
        <FrameLayout
            android:id="@+id/toolPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/metroBgSecondary">

            <!-- Crop -->
            <LinearLayout
                android:id="@+id/panelCrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <TextView android:id="@+id/cropFree" style="@style/EditorChip" android:text="@string/crop_free" />
                <TextView android:id="@+id/cropSquare" style="@style/EditorChip" android:text="@string/crop_1_1" />
                <TextView android:id="@+id/crop43" style="@style/EditorChip" android:text="@string/crop_4_3" />
                <TextView android:id="@+id/crop169" style="@style/EditorChip" android:text="@string/crop_16_9" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/rotateLeftBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/metro_row_pressed"
                    android:contentDescription="@string/rotate"
                    android:padding="9dp"
                    android:src="@drawable/ic_fluent_rotate_left_24_regular"
                    android:tint="@color/metroTextPrimary" />

                <ImageButton
                    android:id="@+id/flipBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/metro_row_pressed"
                    android:contentDescription="@string/flip"
                    android:padding="9dp"
                    android:src="@drawable/ic_fluent_flip_horizontal_24_regular"
                    android:tint="@color/metroTextPrimary" />
            </LinearLayout>

            <!-- Adjust -->
            <LinearLayout
                android:id="@+id/panelAdjust"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView style="@style/EditorSliderLabel" android:text="@string/brightness" />
                <SeekBar android:id="@+id/seekBrightness" style="@style/EditorSeek" android:max="200" android:progress="100" />

                <TextView style="@style/EditorSliderLabel" android:text="@string/contrast" />
                <SeekBar android:id="@+id/seekContrast" style="@style/EditorSeek" android:max="200" android:progress="100" />

                <TextView style="@style/EditorSliderLabel" android:text="@string/saturation" />
                <SeekBar android:id="@+id/seekSaturation" style="@style/EditorSeek" android:max="200" android:progress="100" />

                <TextView
                    android:id="@+id/documentBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/search_filter_chip_bg"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_deepix_ai_orb_24"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/document"
                    android:textColor="@color/metroTextPrimary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Draw -->
            <LinearLayout
                android:id="@+id/panelDraw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/swatchRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <SeekBar
                    android:id="@+id/seekBrush"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:max="48"
                    android:progress="10"
                    android:progressTint="?attr/accentColor"
                    android:thumbTint="?attr/accentColor" />

                <ImageButton
                    android:id="@+id/undoStrokeBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/metro_row_pressed"
                    android:contentDescription="@string/undo_stroke"
                    android:padding="9dp"
                    android:src="@drawable/ic_fluent_arrow_undo_24_regular"
                    android:tint="@color/metroTextPrimary" />
            </LinearLayout>

            <!-- Perspective -->
            <TextView
                android:id="@+id/panelPerspective"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="@string/perspective_hint"
                android:textColor="@color/metroTextSecondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom bar (tools) / action bar (apply-cancel) -->
        <FrameLayout
            android:id="@+id/bottomArea"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/metroBgPrimary">

            <LinearLayout
                android:id="@+id/toolBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/toolCrop" style="@style/EditorToolTab">
                    <ImageView style="@style/EditorToolIcon" android:src="@drawable/ic_fluent_crop_24_regular" />
                    <TextView style="@style/EditorToolLabel" android:text="@string/crop" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolPerspective" style="@style/EditorToolTab">
                    <ImageView style="@style/EditorToolIcon" android:src="@drawable/ic_fluent_perspective_24_regular" />
                    <TextView style="@style/EditorToolLabel" android:text="@string/perspective" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolDraw" style="@style/EditorToolTab">
                    <ImageView style="@style/EditorToolIcon" android:src="@drawable/ic_fluent_brush_24_regular" />
                    <TextView style="@style/EditorToolLabel" android:text="@string/draw" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolAdjust" style="@style/EditorToolTab">
                    <ImageView style="@style/EditorToolIcon" android:src="@drawable/ic_fluent_options_24_regular" />
                    <TextView style="@style/EditorToolLabel" android:text="@string/adjust" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolActionBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/toolCancelBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/metro_row_pressed"
                    android:contentDescription="@string/cancel"
                    android:padding="12dp"
                    android:src="@drawable/ic_fluent_dismiss_24_regular"
                    android:tint="@color/metroTextPrimary" />

                <TextView
                    android:id="@+id/toolTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/metroTextPrimary"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/toolApplyBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/metro_row_pressed"
                    android:contentDescription="@string/apply"
                    android:padding="12dp"
                    android:src="@drawable/ic_fluent_checkmark_24_regular"
                    android:tint="?attr/accentColor" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/editorLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/accentColor"
        android:visibility="gone" />
</FrameLayout>
