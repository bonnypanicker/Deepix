<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/mainSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/imageGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingTop="2dp"
            android:paddingEnd="0dp"
            android:paddingBottom="84dp" />

        <LinearLayout
            android:id="@+id/topOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <FrameLayout
                android:id="@+id/topChrome"
                android:layout_width="match_parent"
                android:layout_height="128dp">

                <ImageButton
                    android:id="@+id/menuBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|top"
                    android:layout_marginStart="4dp"
                    android:alpha="0.2"
                    android:background="@android:color/transparent"
                    android:contentDescription="Menu"
                    android:padding="12dp"
                    android:src="@drawable/ic_fluent_navigation_24_regular"
                    android:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/screenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:includeFontPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:text="collection"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp"
                    android:fontFamily="sans-serif-light"
                    android:visibility="visible" />

                <ImageButton
                    android:id="@+id/searchLaunchBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|top"
                    android:layout_marginEnd="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Search"
                    android:padding="12dp"
                    android:src="@drawable/ic_fluent_search_24_regular"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/searchPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/search_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_search_24_regular"
                        android:tint="#8A8A8A" />

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search this section"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#484848"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/searchDismissBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="6dp"
                        android:text="cancel"
                        android:textAllCaps="true"
                        android:textColor="#8A8A8A"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/searchMetaText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingTop="10dp"
                    android:text="Semantic + metadata search across the current section"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selectionPill"
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="84dp"
            android:background="@drawable/pill_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/shareSelectionBtn"
                android:layout_width="64dp"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:contentDescription="Share selected"
                android:padding="15dp"
                android:src="@drawable/ic_fluent_share_24_regular"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/deleteSelectionBtn"
                android:layout_width="64dp"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:contentDescription="Delete selected"
                android:padding="15dp"
                android:src="@drawable/ic_fluent_delete_24_regular"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:background="#000000"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/bottomCollections"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <ImageView
                    android:id="@+id/bottomCollectionsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fluent_image_24_regular"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomAlbums"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <ImageView
                    android:id="@+id/bottomAlbumsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fluent_album_24_regular"
                    android:tint="#8A8A8A" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomFavorites"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <ImageView
                    android:id="@+id/bottomFavoritesIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fluent_heart_24_regular"
                    android:tint="#8A8A8A" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomVideos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <ImageView
                    android:id="@+id/bottomVideosIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fluent_video_24_regular"
                    android:tint="#8A8A8A" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0A0A0A"
        android:orientation="vertical"
        android:paddingTop="0dp">

        <TextView
            android:id="@+id/drawerCollection"
            style="@style/MetroDrawerItem"
            android:text="collection" />

        <TextView
            android:id="@+id/drawerAlbums"
            style="@style/MetroDrawerItem"
            android:text="albums" />

        <TextView
            android:id="@+id/drawerSearch"
            style="@style/MetroDrawerItem"
            android:text="search" />

        <TextView
            android:id="@+id/drawerIndex"
            style="@style/MetroDrawerItem"
            android:text="start indexing" />

        <TextView
            android:id="@+id/drawerAlbumScope"
            style="@style/MetroDrawerItem"
            android:text="album scope" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:text="Waiting for gallery permission..."
            android:textAllCaps="true"
            android:textColor="#8A8A8A"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:indeterminate="true"
            android:indeterminateTint="#3B9EFF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/resultCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp"
            android:textColor="#6DB8FF"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
