<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metroBgPrimary">

    <FrameLayout
        android:id="@+id/mainSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/metroBgPrimary">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/imageGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingTop="2dp"
            android:paddingEnd="0dp"
            android:paddingBottom="84dp" />

        <LinearLayout
            android:id="@+id/topOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/metroBgPrimary"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/titleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/screenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="56dp"
                    android:singleLine="true"
                    android:text="@string/collections_title"
                    android:textAppearance="@style/TextAppearance.Metro.ScreenTitle" />

                <ImageButton
                    android:id="@+id/addAlbumBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/add_smart_album"
                    android:padding="10dp"
                    android:src="@drawable/ic_fluent_add_24_regular"
                    android:tint="@color/metroTextPrimary"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/search_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageButton
                    android:id="@+id/menuBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu"
                    android:padding="10dp"
                    android:src="@drawable/ic_fluent_navigation_24_regular"
                    android:tint="@color/metroTextPrimary" />

                <ImageView
                    android:id="@+id/searchImageThumb"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@string/similar_image"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/searchSparkle"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/ai_search"
                    android:src="@drawable/ic_deepix_ai_orb_24" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="@color/metroTextPrimary"
                    android:textColorHint="@color/metroTextSecondary"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/searchTrailingBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search"
                    android:padding="11dp"
                    android:src="@drawable/ic_fluent_search_24_regular"
                    android:tint="@color/metroTextPrimary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/searchPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/metroBgPrimary"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/searchHeaderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/searchResultSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:textAllCaps="true"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/searchFilterBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/search_filter_chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_fluent_filter_24_regular"
                            android:tint="@color/metroTextPrimary" />

                        <TextView
                            android:id="@+id/searchFilterLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:includeFontPadding="false"
                            android:text="@string/sort_filter"
                            android:textColor="@color/metroTextPrimary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/searchActivePillsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fadeScrollbars="false"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/searchActivePills"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:id="@+id/searchQuickPillsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fadeScrollbars="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/searchQuickPills"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>

        <!-- Metro selection command bar: flat, full-width, replaces the bottom nav
             while multi-selecting (matches the WP10 command-bar pattern). -->
        <LinearLayout
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bottom_nav_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/selectAllBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/select_all"
                        android:src="@drawable/ic_fluent_select_all_24_regular"
                        android:tint="@color/metroTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:text="@string/select_all_lower"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shareSelectionBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/share_selected"
                        android:src="@drawable/ic_fluent_share_24_regular"
                        android:tint="@color/metroTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:text="@string/share_lower"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/safeSelectionBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/move_to_safe"
                        android:src="@drawable/ic_deepix_safe_24_regular"
                        android:tint="@color/metroTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:text="@string/safe_lower"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/deleteSelectionBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/delete_selected"
                        android:src="@drawable/ic_fluent_delete_24_regular"
                        android:tint="@color/metroTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:text="@string/delete_lower"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.devomind.gallerysearch.FastScrollIndicator
            android:id="@+id/fastScrollIndicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bottom_nav_bg"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/bottomCollections"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <ImageView
                    android:id="@+id/bottomCollectionsIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/tab_collection"
                    android:src="@drawable/ic_deepix_collections_24_regular"
                    android:tint="?attr/accentColor" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomVideos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <ImageView
                    android:id="@+id/bottomVideosIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/tab_videos"
                    android:src="@drawable/ic_deepix_video_24_regular"
                    android:tint="@color/metroTextSecondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomAlbums"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <ImageView
                    android:id="@+id/bottomAlbumsIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/tab_albums"
                    android:src="@drawable/ic_deepix_albums_24_regular"
                    android:tint="@color/metroTextSecondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomFavorites"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <ImageView
                    android:id="@+id/bottomFavoritesIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/tab_favorites"
                    android:src="@drawable/ic_deepix_favorite_24_regular"
                    android:tint="@color/metroTextSecondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/metroBgPrimary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/loadingSpinner"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"
                android:indeterminateTint="?attr/accentColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/loading_gallery"
                android:textAllCaps="true"
                android:textColor="@color/metroTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/metroBgSecondary"
        android:orientation="vertical"
        android:paddingTop="0dp">

        <TextView
            android:id="@+id/drawerCollection"
            style="@style/MetroDrawerItem"
            android:text="@string/drawer_collection" />

        <TextView
            android:id="@+id/drawerAlbums"
            style="@style/MetroDrawerItem"
            android:text="@string/drawer_albums" />

        <TextView
            android:id="@+id/drawerSearch"
            style="@style/MetroDrawerItem"
            android:text="@string/drawer_search" />

        <TextView
            android:id="@+id/drawerFolders"
            style="@style/MetroDrawerItem"
            android:text="@string/drawer_folders" />

        <TextView
            android:id="@+id/drawerSafe"
            style="@style/MetroDrawerItem"
            android:text="@string/safe_lower" />

        <TextView
            android:id="@+id/drawerBin"
            style="@style/MetroDrawerItem"
            android:text="@string/bin_title" />

        <TextView
            android:id="@+id/drawerSmartCleanup"
            style="@style/MetroDrawerItem"
            android:text="@string/smart_cleanup_title" />

        <TextView
            android:id="@+id/drawerIndex"
            style="@style/MetroDrawerItem"
            android:text="@string/drawer_start_indexing" />

        <TextView
            android:id="@+id/drawerSettings"
            style="@style/MetroDrawerItem"
            android:text="@string/settings_lower" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:includeFontPadding="false"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:text="@string/waiting_permission"
            android:textAllCaps="true"
            android:textColor="@color/metroTextSecondary"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/accentColor"
            android:visibility="gone" />

        <TextView
            android:id="@+id/resultCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp"
            android:textColor="?attr/accentColorLight"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
