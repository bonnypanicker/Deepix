<?xml version="1.0" encoding="utf-8"?>
<!-- One tour page. A feature page splits the spare height around the copy: the glyph gets the larger
     share above, a smaller gap is held under the text, so the block settles in the lower-middle of
     the screen instead of sitting on the bottom padding. The permissions page collapses the icon area
     to a fixed top gap and lets the ruled row list take the weight, with no gap below it.
     OnboardingPanelAdapter swaps those weights and rescales every size to the screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/panelIconArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp">

        <ImageView
            android:id="@+id/panelIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/panelEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:textAllCaps="true"
        android:textColor="?attr/accentColor"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/panelTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="-0.045"
        android:lineSpacingMultiplier="1.05"
        android:textColor="@color/metroTextPrimary"
        android:textSize="38sp" />

    <TextView
        android:id="@+id/panelBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.55"
        android:maxWidth="295dp"
        android:textColor="@color/onboardingTextBody"
        android:textSize="14sp" />

    <View
        android:id="@+id/permTopDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="@color/onboardingHairline"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/panelListScroller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/permList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/panelLegalNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/metroTextSecondary"
        android:textColorLink="?attr/accentColor"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.25"
        android:visibility="gone" />
</LinearLayout>
