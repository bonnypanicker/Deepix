<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/metroBgPrimary"
    android:padding="2dp">

    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/metroBgCard"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Multi-select state: dark scrim + accent check over the selected photo. -->
    <View
        android:id="@+id/selectionScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/metroDimScrim"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/selectionCheck"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_fluent_checkmark_24_regular"
        android:tint="?attr/accentColor"
        android:visibility="gone" />

    <!-- Marks a locked video, whose tile is a poster frame like any photo's. -->
    <ImageView
        android:id="@+id/videoBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="6dp"
        android:contentDescription="@string/video"
        android:src="@drawable/ic_fluent_play_24_regular"
        android:tint="@color/metroTextPrimary"
        android:visibility="gone" />
</FrameLayout>
