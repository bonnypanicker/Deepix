<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metroBgPrimary">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/metroBgPrimary"
        android:visibility="gone"
        app:surface_type="texture_view"
        app:resize_mode="fit"
        app:use_controller="false"
        app:show_buffering="never" />

    <!-- Images use this normally; videos keep a fitted frame here until ExoPlayer renders. -->
    <com.devomind.gallerysearch.RotatablePhotoView
        android:id="@+id/photoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/metroBgPrimary" />

    <!-- Primary play / pause / replay control -->
    <ImageButton
        android:id="@+id/playPauseButton"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center"
        android:background="@drawable/video_center_button_bg"
        android:contentDescription="@string/play"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_fluent_play_24_regular"
        android:tint="@color/metroTextPrimary"
        android:visibility="gone" />

    <!-- Video scrubber overlay; shown with controls for videos -->
    <LinearLayout
        android:id="@+id/videoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="92dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/muteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mute"
            android:padding="8dp"
            android:src="@drawable/ic_fluent_speaker_2_24_regular"
            android:tint="@color/metroTextPrimary" />

        <TextView
            android:id="@+id/videoElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:minWidth="40dp"
            android:text="0:00"
            android:textColor="@color/metroTextPrimary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/videoSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="1000"
            android:maxHeight="2dp"
            android:minHeight="2dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:progressDrawable="@drawable/scrubber_progress"
            android:splitTrack="false"
            android:thumb="@drawable/scrubber_thumb"
            android:thumbOffset="0dp" />

        <TextView
            android:id="@+id/videoTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:gravity="end"
            android:includeFontPadding="false"
            android:minWidth="40dp"
            android:text="0:00"
            android:textColor="@color/metroTextSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
