<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/metroBgPrimary"
    android:orientation="vertical"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/albumCoverContainer"
        android:layout_width="match_parent"
        android:layout_height="132dp">

        <ImageView
            android:id="@+id/albumCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <com.devomind.gallerysearch.IndexingOrbView
            android:id="@+id/smartOrb"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/search_section_icon_bg"
            android:contentDescription="@string/ai_search"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/albumName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingStart="2dp"
        android:paddingTop="8dp"
        android:paddingEnd="2dp"
        android:textColor="@color/metroTextPrimary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/albumCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingStart="2dp"
        android:paddingTop="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="12dp"
        android:textColor="@color/metroTextSecondary"
        android:textSize="12sp" />
</LinearLayout>
