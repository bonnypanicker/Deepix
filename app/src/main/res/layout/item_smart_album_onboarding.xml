<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/metroBgPrimary"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/metro_row_pressed"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/onboarding_card_bg"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_deepix_ai_orb_mono_24" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="@string/create_smart_album"
                android:textColor="@color/metroTextPrimary"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/onboardingDismissBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="-14dp"
                android:padding="12dp"
                android:background="@drawable/metro_row_pressed"
                android:clickable="true"
                android:contentDescription="@string/dismiss"
                android:focusable="true"
                android:src="@drawable/ic_fluent_dismiss_24_regular"
                android:tint="@color/metroTextSecondary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:text="@string/smart_album_onboarding_body"
            android:textColor="@color/metroTextSecondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/onboardingCreateBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/onboarding_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:text="@string/create_smart_album_caps"
            android:textColor="@color/metroTextPrimary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
