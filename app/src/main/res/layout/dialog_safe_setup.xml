<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@drawable/dialog_metro_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_fluent_lock_closed_24_regular"
            android:tint="@color/metroAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:text="Set up Safe"
            android:textAllCaps="true"
            android:textColor="@color/metroTextPrimary"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:text="Choose a password to encrypt your Safe. The encrypted file survives uninstall — keep your password safe, it can't be recovered."
        android:textColor="@color/metroTextSecondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/safeSetupLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:textColor="@color/metroAccent"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:text="PASSWORD"
        android:textColor="@color/metroAccent"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/safePassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:autofillHints="newPassword"
        android:background="@drawable/search_bg"
        android:hint="Enter a strong password"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/metroTextPrimary"
        android:textColorHint="@color/metroTextDisabled"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/safePasswordConfirm"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:autofillHints="newPassword"
        android:background="@drawable/search_bg"
        android:hint="Confirm password"
        android:imeOptions="actionDone"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/metroTextPrimary"
        android:textColorHint="@color/metroTextDisabled"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:text="⚠  Keep this password somewhere safe. It cannot be recovered — if you forget it, your photos are lost forever."
        android:textColor="#FFC24B"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/safeSetupCancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:minWidth="88dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="CANCEL"
            android:textColor="@color/metroTextSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/safeSetupContinue"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/onboarding_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:minWidth="104dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="CONTINUE"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
