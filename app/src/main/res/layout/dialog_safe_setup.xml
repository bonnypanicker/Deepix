<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@drawable/dialog_metro_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_fluent_lock_closed_24_regular"
            android:tint="?attr/accentColor" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:includeFontPadding="false"
            android:text="@string/safe_setup_title"
            android:textAppearance="@style/TextAppearance.Metro.DialogTitle" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:text="@string/safe_setup_note"
        android:textAppearance="@style/TextAppearance.Metro.BodySecondary" />

    <TextView
        android:id="@+id/safeSetupLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:textColor="?attr/accentColor"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:includeFontPadding="false"
        android:text="@string/label_password"
        android:textAppearance="@style/TextAppearance.Metro.FieldLabel" />

    <EditText
        android:id="@+id/safePassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:importantForAutofill="no"
        android:background="@drawable/search_bg"
        android:hint="@string/create_password_hint"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/metroTextPrimary"
        android:textColorHint="@color/metroTextDisabled"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/safePasswordConfirm"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:importantForAutofill="no"
        android:background="@drawable/search_bg"
        android:hint="@string/confirm_password_hint"
        android:imeOptions="actionDone"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/metroTextPrimary"
        android:textColorHint="@color/metroTextDisabled"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:text="@string/password_unrecoverable"
        android:textColor="@color/metroWarning"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/safeSetupCancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/metro_row_pressed"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/cancel"
            android:textAppearance="@style/TextAppearance.Metro.ButtonLabel"
            android:textColor="@color/metroTextSecondary" />

        <TextView
            android:id="@+id/safeSetupContinue"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/onboarding_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="104dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/continue_label"
            android:textAppearance="@style/TextAppearance.Metro.ButtonLabel"
            android:textColor="@color/metroTextPrimary" />
    </LinearLayout>
</LinearLayout>
