<?xml version="1.0" encoding="utf-8"?>
<!-- Search category card: 96dp-contained row on the standard 3dp Metro card fill (pilled against
     the page background) — 72dp rounded cover with icon fallback, label + count, trailing
     chevron. Rows stack with card gaps into the results landing list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/metro_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/metro_row_pressed"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/metro_card_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/sectionCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/sectionIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:tint="@color/metroTextSecondary"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/metroTextPrimary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/sectionCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:textColor="@color/metroTextSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/sectionChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_fluent_chevron_right_24_regular"
        android:tint="@color/metroTextSecondary" />
</LinearLayout>
