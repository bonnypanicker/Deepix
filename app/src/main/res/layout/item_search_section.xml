<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/search_section_icon_bg">
            <ImageView
                android:id="@+id/sectionIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:tint="@color/metroTextPrimary" />
        </FrameLayout>
        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textColor="@color/metroTextPrimary"
            android:textSize="21sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sectionCard"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/search_section_card_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/sectionCover"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/album_cover_rounded_bg"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/sectionQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/metroTextPrimary"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/sectionCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:textColor="@color/metroTextSecondary"
                android:textSize="16sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/sectionChevron"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_fluent_chevron_right_24_regular"
            android:tint="@color/metroTextSecondary" />
    </LinearLayout>
</LinearLayout>
