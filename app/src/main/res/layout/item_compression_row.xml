<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/metro_row_pressed"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/rowThumbnail"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@color/metroBgCard"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/metroTextPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/rowSizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingTop="2dp"
            android:textColor="@color/metroTextStrong"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rowStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingTop="2dp"
            android:textColor="@color/metroTextSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/rowSpinner"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="12dp"
        android:indeterminateTint="?attr/accentColor"
        android:visibility="gone" />
</LinearLayout>
