<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compressionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metroBgPrimary"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="6dp"
            android:background="@drawable/metro_row_pressed"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_fluent_back_24_regular"
            android:tint="@color/metroTextPrimary" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:textColor="@color/metroTextPrimary"
            android:textSize="22sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:background="@color/metroBgTertiary"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/summaryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:textColor="?attr/accentColor"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/summaryDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingTop="2dp"
            android:textColor="@color/metroTextStrong"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/qualityHigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/metro_row_pressed"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="High · 90"
                android:textColor="@color/metroTextStrong"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/qualityBalanced"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/metro_row_pressed"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Balanced · 80"
                android:textColor="@color/metroTextStrong"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/qualitySmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/metro_row_pressed"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Small · 65"
                android:textColor="@color/metroTextStrong"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:text="Tap a photo to compare it with the compressed version."
        android:textColor="@color/metroTextSecondary"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/compressionList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/batchProgressRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/batchProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/metroTextStrong"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/batchProgressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="?attr/accentColor" />
    </LinearLayout>

    <TextView
        android:id="@+id/keepBothBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/metroBgCard"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/metro_row_pressed"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="Keep both"
        android:textColor="?attr/accentColor"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/replaceBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/accentColor"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/metro_row_pressed"
        android:gravity="center"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:text="Replace originals"
        android:textColor="@color/metroTextPrimary"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
