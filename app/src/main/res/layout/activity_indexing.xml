<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/indexingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="12dp"
                android:src="@drawable/ic_fluent_back_24_regular"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="indexing"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp" />

                <!-- ===================== STATUS + CONTROLS ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="STATUS" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/indexStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Preparing…"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/indexSubStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingTop="3dp"
                        android:text="On-device AI · nothing leaves your phone"
                        android:textColor="#9A9A9A"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/indexCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingTop="6dp"
                        android:textColor="@color/metroAccent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/indexProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:progressBackgroundTint="#333333"
                        android:progressTint="@color/metroAccent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnIndexPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/crop_search_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:minWidth="112dp"
                            android:paddingStart="24dp"
                            android:paddingTop="11dp"
                            android:paddingEnd="24dp"
                            android:paddingBottom="11dp"
                            android:text="Pause"
                            android:textAlignment="center"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnIndexStop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/pill_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:minWidth="96dp"
                            android:paddingStart="24dp"
                            android:paddingTop="11dp"
                            android:paddingEnd="24dp"
                            android:paddingBottom="11dp"
                            android:text="Stop"
                            android:textAlignment="center"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===================== MEDIA PROCESSING INFO ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="MEDIA PROCESSING" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/onboarding_card_bg"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="Your photos never leave your device. Everything is processed locally using on-device AI to enrich your library with intelligent metadata — no internet connection required."
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="During the initial scan, you may notice:"
                        android:textColor="@color/metroTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• Increased battery usage\n• Additional storage being used for the search index\n• Slightly slower performance while processing"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="This is a one-time process that analyzes your existing library."
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="After the initial scan is complete, new photos are processed automatically as they are added, usually only a few items at a time. This keeps your library up to date with minimal impact on battery and performance."
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Processing time depends on the size of your photo collection and may take from a few minutes to several hours."
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- ===================== POWER ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="POWER" />

                <LinearLayout
                    android:id="@+id/rowCharging"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Index only while charging" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Pause AI indexing until the device is plugged in" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCharging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowNightCharging"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Night charging only" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Only run overnight (10 PM – 7 AM) while plugged in" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchNightCharging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- ===================== FOLDERS ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="FOLDERS" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="Choose which folders AI search indexes. This does not change your gallery — every photo still shows normally."
                    android:textColor="#9A9A9A"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/rowSelectAll"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Select all folders" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Index every folder, including ones you add later" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/checkSelectAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/metroAccent"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <ProgressBar
                    android:id="@+id/loading"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:indeterminateTint="@color/metroAccent" />

                <LinearLayout
                    android:id="@+id/foldersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
