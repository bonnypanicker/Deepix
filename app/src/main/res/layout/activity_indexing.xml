<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/indexingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metroBgPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="6dp"
                android:background="@drawable/metro_row_pressed"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/ic_fluent_back_24_regular"
                android:tint="@color/metroTextPrimary" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="@string/indexing_title"
                    android:textColor="@color/metroTextPrimary"
                    android:textSize="40sp" />

                <!-- ===================== STATUS + CONTROLS ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/section_status" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/indexStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/indexing_preparing"
                        android:textColor="@color/metroTextPrimary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/indexSubStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingTop="3dp"
                        android:text="@string/indexing_offline_note"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/indexCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingTop="6dp"
                        android:textColor="?attr/accentColor"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/indexProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:progressBackgroundTint="#333333"
                        android:progressTint="?attr/accentColor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnIndexPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/crop_search_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:minWidth="112dp"
                            android:paddingStart="24dp"
                            android:paddingTop="11dp"
                            android:paddingEnd="24dp"
                            android:paddingBottom="11dp"
                            android:text="@string/pause"
                            android:textAlignment="center"
                            android:textColor="@color/metroTextPrimary"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/btnIndexStop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/pill_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:minWidth="96dp"
                            android:paddingStart="24dp"
                            android:paddingTop="11dp"
                            android:paddingEnd="24dp"
                            android:paddingBottom="11dp"
                            android:text="@string/stop"
                            android:textAlignment="center"
                            android:textColor="@color/metroTextPrimary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===================== MEDIA PROCESSING INFO ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/section_media_processing" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/onboarding_card_bg"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/indexing_privacy_para"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/indexing_initial_scan_intro"
                        android:textColor="@color/metroTextPrimary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/indexing_initial_scan_bullets"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/indexing_one_time_note"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/indexing_after_scan_para"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/indexing_duration_note"
                        android:textColor="@color/metroTextSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- ===================== POWER ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/section_power" />

                <LinearLayout
                    android:id="@+id/rowCharging"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/charging_only_title" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/charging_only_subtitle" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCharging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowNightCharging"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/overnight_only_title" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/overnight_only_subtitle" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchNightCharging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- ===================== FOLDERS ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/section_folders" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/indexed_folders_intro"
                    android:textColor="@color/metroTextSecondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/rowSelectAll"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/select_all_folders" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/index_every_folder_subtitle" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/checkSelectAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/colorAccent"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <ProgressBar
                    android:id="@+id/loading"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:indeterminateTint="?attr/accentColor" />

                <LinearLayout
                    android:id="@+id/foldersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
