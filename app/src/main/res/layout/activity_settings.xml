<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metroBgPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/ic_fluent_back_24_regular"
                android:tint="@color/metroTextPrimary" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="@string/settings_lower"
                    android:textColor="@color/metroTextPrimary"
                    android:textSize="40sp" />

                <!-- ===================== DISPLAY ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/section_display" />

                <LinearLayout
                    android:id="@+id/rowCollage"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/collage_layout" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCollage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowThumbnailSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView style="@style/SettingsRowTitle" android:text="@string/thumbnail_size" />

                            <TextView
                                style="@style/SettingsRowSubtitle"
                                android:text="@string/thumbnail_size_subtitle" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/thumbnailSizeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:text="@string/size_medium"
                            android:textColor="?attr/accentColor"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/thumbnailSizeSlider"
                        style="@style/SettingsSlider"
                        android:layout_marginTop="8dp"
                        android:max="4"
                        android:progress="2" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowAccentColor"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/accent_color" />

                        <TextView
                            android:id="@+id/accentColorSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/accent_azure" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="@color/metroTextTertiary" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowPinned"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/pinned_albums_in_collections" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchPinned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowAlbumFolderSize"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/album_folder_size" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAlbumFolderSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- ===================== NAVIGATION ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/section_navigation" />

                <LinearLayout android:id="@+id/rowBottomBarOrder" style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/bottom_bar_order" />
                        <TextView
                            android:id="@+id/bottomBarOrderSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/bottom_bar_order_subtitle" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="@color/metroTextTertiary" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowBottomBarFolders" style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/bottom_bar_folders" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBottomBarFolders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowBottomBarSafe" style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/bottom_bar_safe" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBottomBarSafe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowDefaultPage" style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/default_page" />
                        <TextView android:id="@+id/defaultPageSubtitle" style="@style/SettingsRowSubtitle" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="@color/metroTextTertiary" />
                </LinearLayout>

                <!-- ===================== INDEXING ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/section_indexing" />

                <!-- Link to the dedicated Indexing page (status, folders, power, info) -->
                <LinearLayout
                    android:id="@+id/rowIndexing"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/indexing_label" />

                        <TextView
                            android:id="@+id/indexingSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/manage_indexing" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="@color/metroTextTertiary" />
                </LinearLayout>

                <!-- People Phase 1 harness — only in debug builds -->
                <LinearLayout
                    android:id="@+id/rowFaceValidation"
                    style="@style/SettingsRow"
                    android:visibility="gone">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="face validation (debug)" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="run YuNet + MobileFaceNet on a photo" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="@color/metroTextTertiary" />
                </LinearLayout>

                <!-- ===================== PRIVACY ===================== -->
                <TextView
                    android:id="@+id/privacyHeader"
                    style="@style/SettingsSectionHeader"
                    android:text="@string/section_privacy" />

                <LinearLayout
                    android:id="@+id/rowBlurSensitive"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/blur_sensitive" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBlurSensitive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- ===================== SAFE ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/section_safe" />

                <LinearLayout
                    android:id="@+id/rowSafeLocation"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/safe_storage_location" />

                        <TextView
                            android:id="@+id/safeLocationSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/pictures" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="@color/metroTextTertiary" />
                </LinearLayout>

                <!-- ===================== STORAGE ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/section_storage" />

                <LinearLayout
                    android:id="@+id/rowRecycleBin"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/recycle_bin_label" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchRecycleBin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- ===================== ABOUT ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/section_about" />

                <LinearLayout style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/app_name" />

                        <TextView
                            android:id="@+id/aboutVersion"
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/version" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="@string/on_device_ai" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="@string/on_device_ai_subtitle" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
