<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="12dp"
                android:src="@drawable/ic_fluent_back_24_regular"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="settings"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp" />

                <!-- ===================== DISPLAY ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="DISPLAY" />

                <LinearLayout
                    android:id="@+id/rowCollage"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Collage layout" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Mixed large + small tiles instead of an even grid" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCollage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowCollageSize"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Collage thumbnail size" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Size of tiles in collage layout" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/collageMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Smaller collage tiles"
                        android:padding="6dp"
                        android:src="@drawable/ic_fluent_subtract_24_regular"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/collageValue"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                    <ImageButton
                        android:id="@+id/collagePlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Larger collage tiles"
                        android:padding="6dp"
                        android:src="@drawable/ic_fluent_add_24_regular"
                        android:tint="#FFFFFF" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowGridColumns"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Grid columns" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Number of photos per row in grid layout" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/colMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Fewer columns"
                        android:padding="6dp"
                        android:src="@drawable/ic_fluent_subtract_24_regular"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/colValue"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                    <ImageButton
                        android:id="@+id/colPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="More columns"
                        android:padding="6dp"
                        android:src="@drawable/ic_fluent_add_24_regular"
                        android:tint="#FFFFFF" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowPinned"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Pinned albums in Collections" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Show a pinned-albums strip atop the Collections page" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchPinned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- ===================== INDEXING ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="INDEXING" />

                <!-- Live indexing status + controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/indexStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Preparing…"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/indexSubStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingTop="3dp"
                        android:text="On-device AI · nothing leaves your phone"
                        android:textColor="#9A9A9A"
                        android:textSize="13sp" />

                    <ProgressBar
                        android:id="@+id/indexProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:progressBackgroundTint="#333333"
                        android:progressTint="@color/metroAccent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnIndexPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/crop_search_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:minWidth="112dp"
                            android:paddingStart="24dp"
                            android:paddingTop="11dp"
                            android:paddingEnd="24dp"
                            android:paddingBottom="11dp"
                            android:text="Pause"
                            android:textAlignment="center"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnIndexStop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/pill_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:minWidth="96dp"
                            android:paddingStart="24dp"
                            android:paddingTop="11dp"
                            android:paddingEnd="24dp"
                            android:paddingBottom="11dp"
                            android:text="Stop"
                            android:textAlignment="center"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowIndexedFolders"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Indexed folders" />

                        <TextView
                            android:id="@+id/indexedFoldersSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="Choose which folders AI search indexes" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="#6F6F6F" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowCharging"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Index only while charging" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Save battery — pause AI photo indexing until the device is plugged in" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCharging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- ===================== PRIVACY ===================== -->
                <TextView
                    android:id="@+id/privacyHeader"
                    style="@style/SettingsSectionHeader"
                    android:text="PRIVACY" />

                <LinearLayout
                    android:id="@+id/rowBlurSensitive"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Blur sensitive content · Beta" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Blur photos our on-device AI flags as NSFW. Tap a photo to view." />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBlurSensitive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- ===================== SAFE ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="SAFE" />

                <LinearLayout
                    android:id="@+id/rowSafeLocation"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Safe storage location" />

                        <TextView
                            android:id="@+id/safeLocationSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="Where the encrypted Safe file is stored" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="#6F6F6F" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowSafePath"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Safe file" />

                        <TextView
                            android:id="@+id/safePathSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="Not set up" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===================== STORAGE ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="STORAGE" />

                <LinearLayout
                    android:id="@+id/rowRecycleBin"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Recycle bin" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Deleted photos are kept for 30 days before removal" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchRecycleBin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowOpenBin"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Open recycle bin" />

                        <TextView
                            android:id="@+id/binCountSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="Restore or permanently remove deleted photos" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="#6F6F6F" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowDirectDelete"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Delete without asking" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Skip the confirmation dialog when deleting. Requires all-files access." />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDirectDelete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowAllFilesAccess"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="All-files access" />

                        <TextView
                            android:id="@+id/allFilesSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="Needed for the recycle bin and instant deletion" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="#6F6F6F" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowClearCleanup"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Clear Smart Cleanup cache" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="Forget previous cleanup scan results" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="#6F6F6F" />
                </LinearLayout>

                <!-- ===================== ABOUT ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="ABOUT" />

                <LinearLayout style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Deepix" />

                        <TextView
                            android:id="@+id/aboutVersion"
                            style="@style/SettingsRowSubtitle"
                            android:text="Version" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="On-device AI" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="MobileCLIP-S2 · runs fully offline" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
