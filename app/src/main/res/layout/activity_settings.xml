<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="12dp"
                android:src="@drawable/ic_fluent_back_24_regular"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="settings"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp" />

                <!-- ===================== DISPLAY ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="DISPLAY" />

                <LinearLayout
                    android:id="@+id/rowCollage"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Collage layout" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCollage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowThumbnailSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView style="@style/SettingsRowTitle" android:text="Thumbnail size" />

                            <TextView
                                style="@style/SettingsRowSubtitle"
                                android:text="Size of photos in grid and collage layouts" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/thumbnailSizeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:text="Medium"
                            android:textColor="?attr/accentColor"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/thumbnailSizeSlider"
                        style="@style/SettingsSlider"
                        android:layout_marginTop="8dp"
                        android:max="4"
                        android:progress="2" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowAccentColor"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Accent color" />

                        <TextView
                            android:id="@+id/accentColorSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="Azure" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="#6F6F6F" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowPinned"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Pinned albums in Collections" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchPinned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowAlbumFolderSize"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Album folder size" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAlbumFolderSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- ===================== INDEXING ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="INDEXING" />

                <!-- Link to the dedicated Indexing page (status, folders, power, info) -->
                <LinearLayout
                    android:id="@+id/rowIndexing"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Indexing" />

                        <TextView
                            android:id="@+id/indexingSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="Manage indexing" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="#6F6F6F" />
                </LinearLayout>

                <!-- ===================== PRIVACY ===================== -->
                <TextView
                    android:id="@+id/privacyHeader"
                    style="@style/SettingsSectionHeader"
                    android:text="PRIVACY" />

                <LinearLayout
                    android:id="@+id/rowBlurSensitive"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Blur sensitive content · Beta" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBlurSensitive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- ===================== SAFE ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="SAFE" />

                <LinearLayout
                    android:id="@+id/rowSafeLocation"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Safe storage location" />

                        <TextView
                            android:id="@+id/safeLocationSubtitle"
                            style="@style/SettingsRowSubtitle"
                            android:text="Pictures" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fluent_chevron_right_24_regular"
                        android:tint="#6F6F6F" />
                </LinearLayout>

                <!-- ===================== STORAGE ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="STORAGE" />

                <LinearLayout
                    android:id="@+id/rowRecycleBin"
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Recycle bin" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchRecycleBin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- ===================== ABOUT ===================== -->
                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="ABOUT" />

                <LinearLayout style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="Deepix" />

                        <TextView
                            android:id="@+id/aboutVersion"
                            style="@style/SettingsRowSubtitle"
                            android:text="Version" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView style="@style/SettingsRowTitle" android:text="On-device AI" />

                        <TextView
                            style="@style/SettingsRowSubtitle"
                            android:text="MobileCLIP-S2 · runs fully offline" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
