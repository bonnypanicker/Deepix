<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metroBgPrimary"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:text="@string/first_run_title"
        android:textColor="@color/metroTextPrimary"
        android:textSize="34sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/first_run_subtitle"
        android:textColor="@color/metroTextSecondary"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/first_run_body"
        android:textColor="@color/metroTextSecondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="30dp">

        <TextView
            android:id="@+id/btnFirstScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/crop_search_pill"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="200dp"
            android:paddingStart="28dp"
            android:paddingTop="14dp"
            android:paddingEnd="28dp"
            android:paddingBottom="14dp"
            android:text="@string/first_run_scan_now"
            android:textAlignment="center"
            android:textColor="@color/metroTextPrimary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:text="@string/first_run_skip"
            android:textAlignment="center"
            android:textColor="@color/metroTextTertiary"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:indeterminate="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/progressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/metroTextSecondary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
