<?xml version="1.0" encoding="utf-8"?>
<!-- First-run tour: a brand line with a jump-to-last-page X, the swiped panels, and a footer of
     progress segments over the accent CTA. Sizes below are the reference's own numbers at its
     360dp width; FirstRunActivity multiplies them by the screen's ratio factor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/firstRunRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metroBgPrimary"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/brandRow"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/brandText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/metroTextDisabled"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/dismissBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/metro_row_pressed"
            android:clickable="true"
            android:contentDescription="@string/onboarding_dismiss"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_fluent_dismiss_24_regular"
            android:tint="@color/metroTextSecondary" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/panels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="4dp"
        android:paddingEnd="28dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:id="@+id/progressTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/onboarding_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="@string/onboarding_next"
            android:textAllCaps="true"
            android:textColor="@color/metroTextPrimary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
