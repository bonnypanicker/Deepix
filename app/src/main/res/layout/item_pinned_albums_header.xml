<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/metroBgPrimary"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- The 16dp gutter lives on the list (not the container) so items scroll past the
         screen edge instead of clipping against an inset left boundary. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pinnedAlbumsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingStart="16dp" />

</LinearLayout>
