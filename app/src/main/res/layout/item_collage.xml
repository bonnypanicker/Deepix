<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/collageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/metroBgPrimary"
    android:orientation="horizontal"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/leadTile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="2dp"
        android:layout_weight="2">

        <ImageView
            android:id="@+id/leadThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/metroBgCard"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/leadDimScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/metroDimScrim"
            android:visibility="gone" />

        <View
            android:id="@+id/leadSelectionFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/selection_frame"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/leadCheckBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selection_badge_bg"
            android:contentDescription="@null"
            android:padding="3dp"
            android:src="@drawable/ic_fluent_checkmark_24_regular"
            android:tint="@color/metroTextPrimary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/leadVideoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/video_badge_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_fluent_play_24_regular"
                android:tint="@color/metroTextPrimary"
                android:contentDescription="Video" />
            <TextView
                android:id="@+id/durationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/metroTextPrimary"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/topRightTile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/topRightThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/metroBgCard"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/topRightDimScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/metroDimScrim"
                android:visibility="gone" />

            <View
                android:id="@+id/topRightSelectionFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/selection_frame"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/topRightCheckBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selection_badge_bg"
                android:contentDescription="@null"
                android:padding="3dp"
                android:src="@drawable/ic_fluent_checkmark_24_regular"
                android:tint="@color/metroTextPrimary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/topRightVideoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/video_badge_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_fluent_play_24_regular"
                    android:tint="@color/metroTextPrimary"
                    android:contentDescription="Video" />
                <TextView
                    android:id="@+id/durationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/metroTextPrimary"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/bottomRightTile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/bottomRightThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/metroBgCard"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/bottomRightDimScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/metroDimScrim"
                android:visibility="gone" />

            <View
                android:id="@+id/bottomRightSelectionFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/selection_frame"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/bottomRightCheckBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selection_badge_bg"
                android:contentDescription="@null"
                android:padding="3dp"
                android:src="@drawable/ic_fluent_checkmark_24_regular"
                android:tint="@color/metroTextPrimary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/bottomRightVideoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/video_badge_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_fluent_play_24_regular"
                    android:tint="@color/metroTextPrimary"
                    android:contentDescription="Video" />
                <TextView
                    android:id="@+id/durationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/metroTextPrimary"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
