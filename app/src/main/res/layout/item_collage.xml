<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/collageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#000000"
    android:orientation="horizontal"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/leadTile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="2dp"
        android:layout_weight="2">

        <ImageView
            android:id="@+id/leadThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1A1A1A"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/leadDimScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:visibility="gone" />

        <TextView
            android:id="@+id/leadCheckBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selection_badge_bg"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/leadVideoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/video_badge_bg"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="VIDEO"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/topRightTile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/topRightThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1A1A1A"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/topRightDimScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000"
                android:visibility="gone" />

            <TextView
                android:id="@+id/topRightCheckBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selection_badge_bg"
                android:gravity="center"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/topRightVideoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/video_badge_bg"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="VIDEO"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/bottomRightTile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/bottomRightThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1A1A1A"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/bottomRightDimScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bottomRightCheckBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selection_badge_bg"
                android:gravity="center"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bottomRightVideoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/video_badge_bg"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="VIDEO"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
