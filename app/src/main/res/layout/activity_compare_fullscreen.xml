<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen original-vs-compressed comparison. Two stacked PhotoViews (each independently
     zoomable, opaque so the hidden one never peeks through the letterbox); a horizontal swipe at
     fit scale slides the top one aside to reveal the other. The plain top label names the shown
     version and its size — no tab buttons, no boxed banner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compareRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.devomind.gallerysearch.RotatablePhotoView
        android:id="@+id/photoCompressed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <com.devomind.gallerysearch.RotatablePhotoView
        android:id="@+id/photoOriginal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <TextView
        android:id="@+id/compareSavings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="6"
        android:textColor="@color/metroTextPrimary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <ImageButton
        android:id="@+id/compareBackBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="6dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/metro_row_pressed"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_fluent_back_24_regular"
        android:tint="@color/metroTextPrimary" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/keepOriginalBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/metroBgCard"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/metro_row_pressed"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="Keep original"
            android:textColor="@color/metroTextPrimary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/keepCompressedBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="?attr/accentColor"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/metro_row_pressed"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="Keep compressed"
            android:textColor="@color/metroTextPrimary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</FrameLayout>
