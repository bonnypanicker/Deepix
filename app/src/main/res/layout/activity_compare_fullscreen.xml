<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen original-vs-compressed comparison. Two stacked PhotoViews (each independently
     zoomable, opaque so the hidden one never peeks through the letterbox); a horizontal swipe at
     fit scale slides the top one aside to reveal the other. The plain top label names the shown
     version and its size — no tab buttons, no boxed banner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compareRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.devomind.gallerysearch.RotatablePhotoView
        android:id="@+id/photoCompressed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <com.devomind.gallerysearch.RotatablePhotoView
        android:id="@+id/photoOriginal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <View
        android:id="@+id/headerScrim"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/viewer_top_gradient" />

    <!-- Two-pane header: Original | Compressed, each with its size and an active indicator.
         Tapping a pane jumps straight to that version. Clears the back button (66dp start). -->
    <LinearLayout
        android:id="@+id/compareHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="66dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/headerOriginal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/metro_row_pressed"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/headerOriginalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Original"
                android:textColor="@color/metroTextPrimary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/headerOriginalSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/metroTextSecondary"
                android:textSize="12sp" />

            <View
                android:id="@+id/indicatorOriginal"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="?attr/accentColor" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#26FFFFFF" />

        <LinearLayout
            android:id="@+id/headerCompressed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/metro_row_pressed"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/headerCompressedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compressed"
                android:textColor="@color/metroTextPrimary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/headerCompressedSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/metroTextSecondary"
                android:textSize="12sp" />

            <View
                android:id="@+id/indicatorCompressed"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="?attr/accentColor" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/compareBackBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="6dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/metro_row_pressed"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_fluent_back_24_regular"
        android:tint="@color/metroTextPrimary" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/keepOriginalBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/metroBgCard"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/metro_row_pressed"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="Keep original"
            android:textColor="@color/metroTextPrimary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/keepCompressedBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="?attr/accentColor"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/metro_row_pressed"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="Keep compressed"
            android:textColor="@color/metroTextPrimary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</FrameLayout>
