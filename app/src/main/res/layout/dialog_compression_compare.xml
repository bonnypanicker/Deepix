<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/metroBgPrimary"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/compareTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:textColor="@color/metroTextPrimary"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/compareOriginal"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/metroBgCard"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/compareOriginalLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingTop="8dp"
                android:textColor="@color/metroTextStrong"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/compareCompressed"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/metroBgCard"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/compareCompressedLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingTop="8dp"
                android:textColor="?attr/accentColor"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/compareSavings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingTop="12dp"
        android:textColor="@color/metroTextPrimary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
