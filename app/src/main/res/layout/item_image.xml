<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/metroBgPrimary"
    android:padding="2dp">

    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/metroBgCard"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/dimScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:background="@color/metroDimScrim"
        android:visibility="gone" />

    <TextView
        android:id="@+id/checkBadge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/selection_badge_bg"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/metroTextPrimary"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/videoBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/video_badge_bg"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="VIDEO"
        android:textAllCaps="true"
        android:textColor="@color/metroTextPrimary"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/searchBadgeRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/aiBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/search_badge_ai_bg"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="AI"
            android:textColor="@color/metroTextPrimary"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/metadataBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/search_badge_metadata_bg"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:text="META"
            android:textColor="@color/metroMetadataBadgeText"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
