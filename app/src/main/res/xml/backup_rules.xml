<?xml version="1.0" encoding="utf-8"?>
<!--
  What must never leave the device in a Google/Android backup (API 30 and below; the Android 12+
  counterpart is data_extraction_rules.xml).

  The Safe's vault archive is a zip in public storage (Documents/PixaSafe/PixaSafe.zip) and is
  outside app data, so it is never part of a backup. What is left behind here is everything that
  would let an outsider reach it or read the library's derived data: the password verifier and
  biometric blob, the vault's app-private mirror and the app-storage copy of the vault, the map of
  where each vault photo came from, the search/face indices, and the Room database.

  safe_vault and safe_vault_mirror are excluded because they hold a working copy of the encrypted
  archive — the `.bak` a commit keeps until its push is verified and the `.adopt` staging file
  included. A backup carrying them would put the user's locked photos in the cloud, which is the one
  thing the Safe promises not to do.

  The database is excluded because it stores face feature vectors as JSON (faces.embeddingJson) next
  to person names and relationships — biometric material, whatever else it is bundled with. The cost
  is stated plainly: favorites, tags, person names and the metadata cache are NOT restored onto a new
  phone. Photos are not stored in it, so no image is lost and nothing here touches the bin's
  copy-then-delete ordering; the cache refills by indexing, the labels must be re-made by hand.

  Paths are relative to their domain root: shared_prefs/, files/, databases/.
-->
<full-backup-content>
    <!-- Password verifier, salt and the Keystore-encrypted password blob. -->
    <exclude domain="sharedpref" path="photo_safe.xml" />

    <!-- The vault's working copy: the app-storage archive, and the mirror of one kept elsewhere
         (a picked folder, a picked file, or Documents). Both carry .bak/.adopt siblings. -->
    <exclude domain="file" path="safe_vault" />
    <exclude domain="file" path="safe_vault_mirror" />

    <!-- Vault entry name -> the gallery folder each photo was swallowed from. -->
    <exclude domain="file" path="safe_original_paths.json" />
    <!-- Encrypted grid thumbnails; regenerable from the archive with the password. -->
    <exclude domain="file" path="safe_thumbs" />
    <exclude domain="file" path="bin" />
    <exclude domain="file" path="compression" />

    <!-- Image embeddings for the photo library (plus their staging/journal siblings). -->
    <exclude domain="file" path="embedding_index.bin" />
    <exclude domain="file" path="embedding_index.bin.journal" />
    <exclude domain="file" path="embedding_index.bin.tmp" />
    <exclude domain="file" path="metadata_index.bin" />
    <exclude domain="file" path="metadata_index.bin.tmp" />

    <!-- Face feature vectors. -->
    <exclude domain="file" path="face_vector_index.bin" />

    <!-- The Room database: faces.embeddingJson holds the same feature vectors in table form, and the
         schema is a metadata cache plus hand-made labels, none of which belong in a cloud copy.
         -wal/-shm are WAL siblings of the same file and must not survive as a partial database. -->
    <exclude domain="database" path="gallery_metadata.db" />
    <exclude domain="database" path="gallery_metadata.db-wal" />
    <exclude domain="database" path="gallery_metadata.db-shm" />
</full-backup-content>
